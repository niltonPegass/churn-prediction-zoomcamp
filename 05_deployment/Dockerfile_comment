# ============================================================
# Dockerfile — Churn Prediction Service
# ============================================================
# This Dockerfile packages a Python ML web service into a
# container. It uses Gunicorn as the WSGI server to serve
# a Flask/scikit-learn churn prediction model via HTTP.
# ============================================================


# ------------------------------------------------------------
# BASE IMAGE
# ------------------------------------------------------------
# We use the official Python 3.8.12 slim image as the base.
# "slim" is a lightweight variant that strips out unnecessary
# OS packages, reducing the final image size significantly
# compared to the full python:3.8.12 image.
FROM python:3.8.12-slim
FROM python:3.14.4 # niltonpegass 


# ------------------------------------------------------------
# DEPENDENCY MANAGER
# ------------------------------------------------------------
# Pipenv is installed globally via pip so we can use it to
# resolve and install project dependencies in the next steps.
# It combines pip + virtualenv into a single workflow, using
# Pipfile and Pipfile.lock to ensure reproducible installs.
RUN pip install pipenv


# ------------------------------------------------------------
# WORKING DIRECTORY
# ------------------------------------------------------------
# All subsequent commands (COPY, RUN, ENTRYPOINT) will be
# executed relative to this directory inside the container.
# If /app doesn't exist, Docker creates it automatically.
WORKDIR /app


# ------------------------------------------------------------
# DEPENDENCY FILES
# ------------------------------------------------------------
# We copy only the dependency files first — before the rest
# of the source code. This is a best practice: Docker caches
# each layer, so if Pipfile.lock hasn't changed, the next
# RUN step (the actual install) will be served from cache,
# making subsequent builds much faster.
COPY ["Pipfile", "Pipfile.lock", "./"]


# ------------------------------------------------------------
# INSTALL DEPENDENCIES
# ------------------------------------------------------------
# --system   → installs packages into the system Python
#              instead of a virtualenv (not needed in Docker,
#              since the container is already isolated)
# --deploy   → fails the build if Pipfile.lock is out of sync
#              with Pipfile, enforcing reproducibility
RUN pipenv install --deploy --system


# ------------------------------------------------------------
# APPLICATION FILES
# ------------------------------------------------------------
# Now we copy the actual application code and the serialized
# ML model into the working directory. Copying these after
# the dependency install means that changing source code
# won't invalidate the dependency cache layer above.
#
# *.py          → all Python source files (e.g. predict.py)
# churn-model.bin → the trained model, serialized with pickle
COPY ["*.py", "churn-model.bin", "./"]
COPY ["predict.py", "./"] # niltonpegass
COPY ["model/model_C=1.0.bin", "./model/"] # niltonpegass


# ------------------------------------------------------------
# PORT
# ------------------------------------------------------------
# Documents that the service listens on port 9696 at runtime.
# EXPOSE is metadata only — it does not publish the port to
# the host. You still need -p 9696:9696 in `docker run` to
# make it accessible from outside the container.
EXPOSE 9696
EXPOSE 2909 # niltonpegass


# ------------------------------------------------------------
# ENTRYPOINT
# ------------------------------------------------------------
# Defines the command that runs when the container starts.
# Gunicorn is a production-grade WSGI server for Python apps.
#
# --bind=0.0.0.0:9696 → listens on all network interfaces
#                        inside the container on port 9696
# churn_serving:app   → points Gunicorn to the `app` object
#                        inside the churn_serving.py module
ENTRYPOINT ["gunicorn", "--bind=0.0.0.0:9696", "churn_serving:app"]
ENTRYPOINT ["gunicorn", "--bind=0.0.0.0:2909", "predict:app"] #niltonpegass
